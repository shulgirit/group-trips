# Copy to .env for local development (the anonymous Convex backend: `pnpm --filter @together/backend dev`).
# EAS builds take these from the matching EAS environment (development / preview / production),
# which mirror the Convex deployments. Only public values here — secrets live in Convex env.
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
EXPO_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
# Where invite links point (defaults to https://together.app)
# EXPO_PUBLIC_SITE_URL=https://together.app
# Google sign-in client ids (Google Cloud console), per platform
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
