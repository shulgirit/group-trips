{
  "expo": {
    "name": "Together",
    "slug": "together-group-plans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "together",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.together.trips",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:togethergroup.app"
      ],
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "he",
          "ar",
          "es"
        ],
        "CFBundleDevelopmentRegion": "en"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1b2d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.together.trips",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "togethergroup.app",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "togethergroup.app",
              "pathPrefix": "/t/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070C16",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#b08a55"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Together shows you on the trip map and finds places near you while the app is open."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Together uses your photos when you add one to the trip guide, a document or your guide avatar.",
          "cameraPermission": "Together uses the camera when you photograph a ticket or document for the trip."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "b7f14588-d89f-4ee4-8e3e-a113ee10d933"
      }
    },
    "owner": "shulgirit"
  }
}
