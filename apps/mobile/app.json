{
  "expo": {
    "name": "Together",
    "slug": "together-group-plans",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "together",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.together.trips",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:togethergroup.app"
      ],
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "he",
          "ar",
          "es"
        ],
        "CFBundleDevelopmentRegion": "en",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0f1b2d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.together.trips",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "togethergroup.app",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "togethergroup.app",
              "pathPrefix": "/t/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070C16",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#b08a55"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Together uses your precise location only while the app is open: to show you on the trip map, to sort the trip's places by distance, and — only if you choose to share — to show your position to the members of your trip for the time you pick (1 hour, 4 hours or until the end of the day). You can stop at any moment."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Together uses a photo you choose from your library as your profile picture, the trip cover, a document or ticket for the trip, or a picture you send to the trip guide.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "tal-pituach",
          "project": "react-native",
          "url": "https://de.sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7f14588-d89f-4ee4-8e3e-a113ee10d933"
      }
    },
    "owner": "shulgirit",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b7f14588-d89f-4ee4-8e3e-a113ee10d933",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    }
  }
}
