rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    // Members carry a server-set `member` claim (Google accounts get it
    // at join; custom tokens — kids and the legacy shared identity — are
    // only ever minted by our own server).
    function isMember() {
      return signedIn()
        && (request.auth.token.firebase.sign_in_provider == 'custom'
            || request.auth.token.member == true);
    }

    // Shared documents: any member reads; only the uploader writes.
    match /trips/{tripId}/documents/shared/{uid}/{fileName} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Private documents: owner only.
    match /trips/{tripId}/documents/private/{uid}/{fileName} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }

    // Trip photos and other shared media
    match /trips/{tripId}/photos/{allPaths=**} {
      allow read, write: if isMember();
    }
  }
}
