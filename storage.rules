rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isCustomIdentity() {
      return request.auth.token.firebase.sign_in_provider == 'custom';
    }
    function isGoogleUser() {
      return request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isMember() {
      return signedIn()
        && (isCustomIdentity()
            || firestore.exists(/databases/(default)/documents/trips/sicily-2026/users/$(request.auth.uid)));
    }

    // Shared documents: any member can read; only the uploader can write.
    match /trips/{tripId}/documents/shared/{uid}/{fileName} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    // Private documents: owner only, personal Google identity required.
    match /trips/{tripId}/documents/private/{uid}/{fileName} {
      allow read, write: if isMember()
        && request.auth.uid == uid
        && isGoogleUser();
    }

    // Trip photos and other shared media
    match /trips/{tripId}/photos/{allPaths=**} {
      allow read, write: if isMember();
    }
  }
}
