rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isGoogleUser() {
      return request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Shared documents: everyone on the trip can read; only the uploader
    // (path-scoped) can write/delete.
    match /trips/{tripId}/documents/shared/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Private documents: owner only, and only with a personal Google
    // identity (the shared custom-token uid is not private).
    match /trips/{tripId}/documents/private/{uid}/{fileName} {
      allow read, write: if signedIn()
        && request.auth.uid == uid
        && isGoogleUser();
    }

    // Trip photos and other shared media
    match /trips/{tripId}/photos/{allPaths=**} {
      allow read, write: if signedIn();
    }
  }
}
