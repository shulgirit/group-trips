rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only users signed in via our custom-token flow or Google (password
    // holders / family members). No public sign-in.
    function signedIn() {
      return request.auth != null;
    }
    function isGoogleUser() {
      return request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /trips/{tripId} {
      allow read, write: if signedIn();
    }

    // Documents: shared ones visible to everyone, private ones only to
    // their owner (private requires a real Google identity — the shared
    // custom-token identity is not personal).
    match /trips/{tripId}/documents/{docId} {
      allow read: if signedIn()
        && (resource.data.visibility == 'shared'
            || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.visibility == 'shared' || isGoogleUser());
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // User profiles: everyone can see who's who, each user writes only
    // their own (with a personal Google identity).
    match /trips/{tripId}/users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == uid
        && isGoogleUser();
    }

    // AI chat sessions are always private to their owner.
    match /trips/{tripId}/chatSessions/{sessionId} {
      allow read, update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && isGoogleUser();
    }

    // All other trip data is shared between everyone on the trip
    match /trips/{tripId}/{coll}/{docId} {
      allow read, write: if signedIn()
        && !(coll in ['documents', 'chatSessions', 'users']);
    }
    match /trips/{tripId}/{coll}/{docId}/{sub}/{subId} {
      allow read, write: if signedIn()
        && !(coll in ['documents', 'chatSessions', 'users']);
    }
  }
}
