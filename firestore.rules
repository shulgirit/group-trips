rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Legacy shared identity, minted server-side only for trip-password holders
    function isCustomIdentity() {
      return request.auth.token.firebase.sign_in_provider == 'custom';
    }
    function isGoogleUser() {
      return request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // A registered personal identity: Google account or a kid's
    // name-based identity — both have a server-created users/{uid} doc.
    function hasProfile() {
      return exists(/databases/$(database)/documents/trips/sicily-2026/users/$(request.auth.uid));
    }
    // A member is either the shared custom identity, or a registered
    // personal identity (created after presenting the join code).
    function isMember() {
      return signedIn() && (isCustomIdentity() || hasProfile());
    }

    match /trips/{tripId} {
      allow read, write: if isMember();
    }

    // Documents: shared ones visible to all members, private ones only to
    // their owner (private requires a personal Google identity).
    match /trips/{tripId}/documents/{docId} {
      allow read: if isMember()
        && (resource.data.visibility == 'shared'
            || resource.data.ownerUid == request.auth.uid);
      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.visibility == 'shared' || hasProfile());
      allow update, delete: if isMember()
        && resource.data.ownerUid == request.auth.uid;
    }

    // User profiles: members can see who's who; each user updates only
    // their own profile. Creation happens server-side at join time.
    match /trips/{tripId}/users/{uid} {
      allow read: if isMember();
      allow update: if isMember() && request.auth.uid == uid;
    }

    // AI chat sessions are always private to their owner.
    match /trips/{tripId}/chatSessions/{sessionId} {
      allow read, update, delete: if isMember()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && hasProfile();
    }

    // Places: every member adds and edits; deleting is for the parents
    // (Google accounts only — kids' name identities cannot delete).
    match /trips/{tripId}/places/{placeId} {
      allow read, create, update: if isMember();
      allow delete: if isMember() && isGoogleUser();
    }

    // All other trip data is shared between the members.
    // pushSubscriptions is server-managed only (Admin SDK).
    match /trips/{tripId}/{coll}/{docId} {
      allow read, write: if isMember()
        && !(coll in ['documents', 'chatSessions', 'users', 'pushSubscriptions', 'places']);
    }
    match /trips/{tripId}/{coll}/{docId}/{sub}/{subId} {
      allow read, write: if isMember()
        && !(coll in ['documents', 'chatSessions', 'users', 'pushSubscriptions']);
    }
  }
}
